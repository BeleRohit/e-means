{
  "algorithm": "e_means",
  "config": {
    "alpha0": 0.2,
    "alpha_min_factor": 0.1,
    "assignment_chunk_size": 256,
    "batch_size": 64,
    "centroid_chunk_size": 64,
    "drop_last": false,
    "dtype": "float64",
    "epochs": 3,
    "finalize": "last_epoch_mean",
    "initial_mass": 1e-10,
    "n_clusters": 8,
    "revival_interval": 5,
    "revival_threshold": 0.1,
    "seed": 2,
    "split_epsilon": 0.0078125
  },
  "dataset": {
    "center_scale": 4.0,
    "n_clusters": 8,
    "n_features": 16,
    "n_test": 400,
    "n_train": 1200,
    "name": "separated",
    "noise_scale": 1.0
  },
  "seed": 2
}
